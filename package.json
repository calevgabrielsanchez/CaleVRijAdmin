{
  "name": "plantilla-clvj",
  "version": "1.0.0",
  "private": true,
  "description": "Plantilla reutilizable Angular y Capacitor con carcasa retro homologada.",
  "scripts": {
    "start": "ng serve",
    "build": "ng build",
    "watch": "ng build --watch --configuration development",
    "cap:sync": "ng build && npx cap sync",
    "cap:assets": "npx capacitor-assets generate --android",
    "cap:android": "npm run build && npm run cap:assets && npx cap sync android",
    "cap:add:android": "npx cap add android",
    "cap:add:ios": "npx cap add ios"
  },
  "dependencies": {
    "@angular/common": "^22.0.0",
    "@angular/compiler": "^22.0.0",
    "@angular/core": "^22.1.5",
    "@angular/forms": "22.2.3",
    "@angular/platform-browser": "^22.0.0",
    "@calevrij/admin-android-directory-access": "file:plugins/android-directory-access",
    "@capacitor/android": "^8.0.0",
    "@capacitor/core": "^8.0.0",
    "@capacitor/ios": "^8.0.0",
    "@fortawesome/angular-fontawesome": "^5.1.0",
    "@fortawesome/fontawesome-svg-core": "^7.3.1",
    "@fortawesome/free-solid-svg-icons": "^7.3.1",
    "rxjs": "^7.8.2",
    "tslib": "^2.8.1",
    "zone.js": "^0.15.1"
  },
  "devDependencies": {
    "@angular/build": "^22.0.0",
    "@angular/cli": "^22.0.0",
    "@angular/compiler-cli": "^22.0.0",
    "@capacitor/assets": "^3.0.5",
    "@capacitor/cli": "^8.0.0",
    "typescript": "^6.0.0"
  }
}
